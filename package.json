{
  "name": "landshoppers",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @landshoppers/db run generate",
    "db:migrate": "pnpm --filter @landshoppers/db exec prisma migrate deploy",
    "db:migrate:dev": "pnpm --filter @landshoppers/db exec prisma migrate dev",
    "db:studio": "pnpm --filter @landshoppers/db exec prisma studio",
    "db:seed": "pnpm --filter @landshoppers/db run seed",
    "db:verify:postgis": "pnpm --filter @landshoppers/db run verify:postgis",
    "db:verify:tables": "pnpm --filter @landshoppers/db run verify:tables",
    "db:smoke": "node scripts/db-smoke.mjs",
    "routes:inventory": "node scripts/generate-route-inventory.mjs",
    "ai:install": "node scripts/python-module.mjs pip install -r apps/ai-service/requirements.txt",
    "ai:install:dev": "node scripts/python-module.mjs pip install -r apps/ai-service/requirements-dev.txt",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "workers:dev": "pnpm --filter @landshoppers/workers run dev",
    "workers:enqueue-smoke": "pnpm --filter @landshoppers/workers run enqueue-smoke",
    "search:bootstrap": "pnpm --filter @landshoppers/api run search:bootstrap",
    "ai:test": "cd apps/ai-service && python -m pytest -q"
  },
  "devDependencies": {
    "next": "16.2.4",
    "pnpm": "9.15.9",
    "turbo": "^2.5.4",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  }
}
