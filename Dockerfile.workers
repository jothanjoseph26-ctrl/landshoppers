# BullMQ workers — deploy as a separate Railway service (same DATABASE_URL, REDIS_URL, OPENSEARCH_URL, AI_SERVICE_URL as API).
FROM node:22-bookworm-slim

WORKDIR /app

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY packages ./packages
COPY apps ./apps
COPY scripts ./scripts

ENV DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/dummy?schema=public"

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @landshoppers/db exec prisma generate
RUN pnpm turbo run build --filter=@landshoppers/workers

ENV NODE_ENV=production
CMD ["pnpm", "--filter", "@landshoppers/workers", "start"]
