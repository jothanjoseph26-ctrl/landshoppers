# Copy to `.env` at repo root. Used by packages/db prisma.config.ts and future apps.

# --- Local ports (avoid collisions with other projects) ---
# PostGIS (docker-compose `postgres`): 55432
# Redis (docker-compose `redis`):       56379
# OpenSearch (docker-compose):            9200
# Next.js dev (`apps/web`):               3000
# Hono API (`apps/api`):                  see API_PORT (default 4001)
# AI service (`apps/ai-service`):       see AI_SERVICE_PORT (default 8000)

# PostgreSQL / PostGIS — host port 55432 → container 5432 (see docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:55432/landshoppers?schema=public"

# Redis / BullMQ — host port 56379 → container 6379
REDIS_URL="redis://localhost:56379"

# OpenSearch (local single-node)
OPENSEARCH_URL="http://localhost:9200"

# API (apps/api — JWT access tokens use HS256)
API_PORT="4001"
JWT_SECRET="change-me-min-16-chars-for-local-dev-only"
JWT_ACCESS_EXPIRES="15m"
# Browser + server-side fetches from Next.js (`apps/web`)
NEXT_PUBLIC_API_URL="http://localhost:4001"
# When true, `/developer/*` requires `ls_access_token` cookie (default off)
NEXT_PUBLIC_PORTAL_GUARD="false"

# AI service (apps/ai-service — FastAPI)
AI_SERVICE_PORT="8000"
AI_SERVICE_URL="http://localhost:8000"
# Use deterministic fixture extraction/SEO (no API keys) for local dev
AI_FIXTURE_MODE="true"
# Set true to insert into Postgres `ai_request_log` (requires DATABASE_URL + psycopg)
AI_AUDIT_TO_DB="false"
# Optional LLM keys (live adapters not wired yet; leave unset + fixture mode)
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""
# XAI_API_KEY=""

# Workers (apps/workers — BullMQ; requires Redis from docker compose)
# REDIS_URL is above

# Next.js web
NEXT_PUBLIC_APP_URL="http://localhost:3000"
