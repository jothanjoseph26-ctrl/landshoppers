# =============================================================================
# LandShoppers — environment template
# Copy to `.env` at repo root:  cp .env.example .env
# Used by packages/db (prisma.config.ts), apps/api, apps/web, apps/workers, apps/ai-service
# =============================================================================

# --- Local ports (docker-compose) ---
# PostGIS: 55432 | Redis: 56379 | OpenSearch: 9200 | Next: 3000 | API: 4001 | AI: 8000

# --- PostgreSQL / PostGIS (Neon or Docker) ---
DATABASE_URL="postgresql://<neon_user>:<neon_password>@<neon_pooler_host>/<neon_database>?sslmode=require&channel_binding=require&schema=public"
DIRECT_URL="postgresql://<neon_user>:<neon_password>@<neon_direct_host>/<neon_database>?sslmode=require&channel_binding=require&schema=public"
# DATABASE_URL="postgresql://postgres:postgres@localhost:55432/landshoppers?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:55432/landshoppers?schema=public"

REDIS_URL="redis://localhost:56379"
OPENSEARCH_URL="http://localhost:9200"
OPENSEARCH_LISTINGS_INDEX="landshoppers-listings-v1"
SEARCH_BACKEND="auto"

NODE_ENV="development"

# --- API (apps/api) ---
API_PORT="4001"
PORT=""
JWT_SECRET="change-me-min-16-chars-for-local-dev-only"
JWT_ACCESS_EXPIRES="15m"
CORS_ORIGINS="http://localhost:3000"
RATE_LIMIT_DISABLED="false"
DEV_OTP_CODE="000000"

# --- Next.js (apps/web) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4001"
NEXT_PUBLIC_PORTAL_GUARD="false"
NEXT_PUBLIC_MAPBOX_TOKEN=""
NEXT_PUBLIC_SALES_WHATSAPP="2349125172692"

# --- AI service (apps/ai-service) ---
AI_SERVICE_PORT="8000"
AI_SERVICE_URL="http://localhost:8000"
AI_SERVICE_HOST="0.0.0.0"
AI_FIXTURE_MODE="true"
AI_AUDIT_TO_DB="false"
AI_RATE_LIMIT_PER_MINUTE="120"
AI_CORS_ORIGINS="http://localhost:3000"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
XAI_API_KEY=""

# --- Email (Resend / SES) ---
RESEND_API_KEY=""
RESEND_FROM="LandShoppers <digest@yourdomain.com>"
EMAIL_FROM="LandShoppers <onboarding@resend.dev>"
SES_FROM_ADDRESS=""
AWS_REGION="af-south-1"

# --- SMS (Termii) ---
TERMII_API_KEY=""
TERMII_SENDER_ID="LandShoppers"

# --- Payments ---
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""
FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""
STRIPE_PUBLIC_KEY=""
STRIPE_SECRET_KEY=""

# --- KYC (Dojah) ---
DOJAH_APP_ID=""
DOJAH_SECRET_KEY=""

# --- Media uploads (S3 + CDN) ---
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
AWS_CLOUDFRONT_DOMAIN=""

# --- WhatsApp (Evolution / bridge) ---
WHATSAPP_WEBHOOK_SECRET=""
WHATSAPP_DEFAULT_LISTING_USER_ID=""
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
SERVICEHUB_WHATSAPP_AUTO_LEAD="false"

# --- Admin / platform flags ---
PLATFORM_MAINTENANCE_MODE="false"
WHATSAPP_AUTO_APPROVE_MIN_SCORE=""

# --- Agent portal feature flags ---
AGENT_WHATSAPP_ENABLED="false"
AGENT_AI_INSIGHTS_ENABLED="true"

# --- ServiceHub / provider ---
PROVIDER_WHATSAPP_ENABLED="false"
SERVICEHUB_MATCH_SCORE_REPEAT_MS="21600000"
SERVICEHUB_LEAD_EMAIL_STUB="1"
SERVICEHUB_REVIEW_INVITE_EMAIL_STUB="1"

# --- OAuth (future) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Seed data (packages/db) ---
# SEED_DEVELOPER_EMAIL="developer@example.test"
# SEED_DEVELOPER_COMPANY_NAME="Demo Estates Ltd"

# --- CI / tooling (optional) ---
GITHUB_TOKEN=""
PLAYWRIGHT_BASE_URL=""
LANDSHOPPERS_PYTHON=""
