# Copy to `.env` at repo root. Used by packages/db prisma.config.ts and future apps.

# --- Local ports (avoid collisions with other projects) ---
# PostGIS (docker-compose `postgres`): 55432
# Redis (docker-compose `redis`):       56379
# OpenSearch (docker-compose):            9200
# Next.js dev (`apps/web`):               3000
# Hono API (`apps/api`):                  see API_PORT (default 4001)
# AI service (`apps/ai-service`):       see AI_SERVICE_PORT (default 8000)

# PostgreSQL / PostGIS - Neon
# DATABASE_URL is the pooled app/runtime connection string.
# DIRECT_URL is the direct database connection string for Prisma migrations and PostGIS extension setup.
# API/workers (`createPrismaClient`): set DATABASE_URL on Railway/Vercel; if unset, DIRECT_URL is used as fallback.
# Replace the placeholders with the values from Neon Dashboard -> Connection details.
DATABASE_URL="postgresql://<neon_user>:<neon_password>@<neon_pooler_host>/<neon_database>?sslmode=require&channel_binding=require&schema=public"
DIRECT_URL="postgresql://<neon_user>:<neon_password>@<neon_direct_host>/<neon_database>?sslmode=require&channel_binding=require&schema=public"
#
# Local Docker alternative:
# DATABASE_URL="postgresql://postgres:postgres@localhost:55432/landshoppers?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:55432/landshoppers?schema=public"

# Redis / BullMQ — host port 56379 → container 6379
REDIS_URL="redis://localhost:56379"

# OpenSearch (local single-node)
OPENSEARCH_URL="http://localhost:9200"
# Listings index created by `pnpm --filter @landshoppers/api run search:bootstrap`
OPENSEARCH_LISTINGS_INDEX="landshoppers-listings-v1"
# auto | postgres | opensearch (forces client); `auto` falls back to Postgres if OpenSearch fails
SEARCH_BACKEND="auto"

# API (apps/api — JWT access tokens use HS256)
API_PORT="4001"
JWT_SECRET="change-me-min-16-chars-for-local-dev-only"
JWT_ACCESS_EXPIRES="15m"
# Browser + server-side fetches from Next.js (`apps/web`)
NEXT_PUBLIC_API_URL="http://localhost:4001"
# When true, `/developer/*` requires `ls_access_token` cookie (default off)
NEXT_PUBLIC_PORTAL_GUARD="false"

# AI service (apps/ai-service — FastAPI)
AI_SERVICE_PORT="8000"
AI_SERVICE_URL="http://localhost:8000"
# Use deterministic fixture extraction/SEO (no API keys) for local dev
AI_FIXTURE_MODE="true"
# Set true to insert into Postgres `ai_request_log` (requires DATABASE_URL + psycopg)
AI_AUDIT_TO_DB="false"
# Optional LLM keys (live adapters not wired yet; leave unset + fixture mode)
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""
# XAI_API_KEY=""

# Workers (apps/workers — BullMQ; requires Redis from docker compose)
# REDIS_URL is above

# WhatsApp webhook (Evolution / bridge → POST /v1/whatsapp/webhook)
# HMAC-SHA256 of the raw JSON body; compare hex to header X-Landshoppers-Signature: sha256=<hex>
# Leave unset for local-only testing (signature checks skipped — set before production).
WHATSAPP_WEBHOOK_SECRET=""
# Listing owner user id when approving WhatsApp extractions (defaults to earliest buyer if unset)
# WHATSAPP_DEFAULT_LISTING_USER_ID=""

# Next.js web
NEXT_PUBLIC_APP_URL="https://landshoppersrealty.com"

# --- Railway (Dockerfile.api / Dockerfile.workers / Dockerfile.ai) ---
# Railway sets PORT on each service; the API also reads API_PORT if you set it.
# On the API service, allow your Vercel origin(s):
# CORS_ORIGINS="https://your-app.vercel.app"
# On Vercel (`apps/web`), set the public Railway API URL:
# NEXT_PUBLIC_API_URL="https://your-api.up.railway.app"
# Provision Postgres (PostGIS), Redis, and optionally OpenSearch elsewhere; paste URLs into Railway variables.
# Run Prisma migrations once against prod DB: `pnpm db:migrate` with DATABASE_URL set (CI or local).
# AI service: optional extra origins for FastAPI CORS (comma-separated):
# AI_CORS_ORIGINS="https://your-app.vercel.app"
